{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs"],
      "ignore": ["templates/apps/**"],
      "project": ["scripts/**/*.mjs"]
    },
    "apps/*": {
      "ignore": ["src/styles/abstracts/**"],
      "ignoreDependencies": ["sass-embedded"]
    }
  }
}
